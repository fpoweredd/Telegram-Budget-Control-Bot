# Required ---------------------------------------------------------------

# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=replace-me
# Comma-separated Telegram user ids. Admins can use /date and /restore.
ADMIN_IDS=111111111
# Other members (optional). Only they get the 14:00 and 21:00 reminders.
USER_IDS=222222222

# Optional (defaults shown) ------------------------------------------------

# GEMINI_MODEL=gemini-flash-latest
# GEMINI_TIMEOUT_SECONDS=60
# LANGUAGE=en                # en or ru
# CURRENCY=€
# TIMEZONE=Europe/Madrid     # IANA name; used for "today", weeks and the schedule
# REPORT_TIME=23:59
# REMINDER_TIMES=14:00,21:00
# DEFAULT_TARGET_DAYS=30     # target date used on first start and after /restore
# DB_PATH=budget.db
# LOG_LEVEL=INFO
